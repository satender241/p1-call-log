# This is only a TEMPLATE. Copy it to a file called .env and put real values there.
# .env stays on your laptop. It is listed in .gitignore, so it never goes to GitHub.

# The database address. From Neon: Dashboard -> Connect -> copy the connection string.
# It contains your database password, so never share it or paste it into a chat.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Which websites may read this API. "*" means any. Later you can put your Vercel link here.
FRONTEND_URL=*
